# Copy this file to .env and fill in your values:
#   cp .env.example .env

# LLM provider API key — required for LLM-based scorers in most notebooks
# Set the key for whichever provider you use in the notebooks
OPENAI_API_KEY=your-openai-api-key-here

# OpenCode evaluation notebook — vLLM on OpenShift AI (no OpenAI cloud key needed)
# Point to your vLLM OpenAI-compatible route; vLLM often accepts any placeholder key.
# OPENAI_API_BASE=https://<vllm-route>/v1
# OPENAI_API_KEY=not-needed
# JUDGE_MODEL=openai:/gpt-oss-20b
# OPENCODE_USE_GUARDRAILS_PII=true   (optional — use Presidio DetectPII; requires guardrails-ai-detect-pii)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# Limits parallel evaluation workers to 1 (prevents threading issues with some scorers)
MLFLOW_GENAI_EVAL_MAX_WORKERS=1

# NPS API key — required for the end-to-end notebook
# Register at https://www.nps.gov/subjects/developer/get-started.htm (free)
# If unset, the notebook falls back to DEMO_KEY (stricter rate limits)
# NPS_API_KEY=your-nps-api-key-here

# ── MLflow tracking configuration ───────────────────────────────────

# Experiment name — set to your preferred name.
# If unset, failure mode notebooks default to "agentic-evaluation"
# and the end-to-end notebook defaults to "nps-agent-evaluation".
# MLFLOW_EXPERIMENT_NAME=

# Choose ONE option below and fill in the corresponding values.

# Option A — RHOAI-managed MLflow (OpenShift AI)
# See the project README for cluster setup steps (oc login, namespace, label).
# MLFLOW_TRACKING_URI=https://<your-rhoai-mlflow-route>/mlflow/
# MLFLOW_TRACKING_TOKEN=<your-openshift-token>    (required for Option A; use: oc whoami -t)
# MLFLOW_WORKSPACE=<your-namespace>               (required for RHOAI workspace-scoped MLflow)
# Development only: uncomment to skip TLS certificate verification.
# This disables certificate and hostname verification, which can expose
# the bearer token to interception. Do not use in production.
# # MLFLOW_TRACKING_INSECURE_TLS=true

# Option B — Local MLflow server
# Start the server first: mlflow server --host 127.0.0.1 --port 5000
# MLFLOW_TRACKING_URI=http://localhost:5000
