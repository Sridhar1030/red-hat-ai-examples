# ── Model endpoint (required) ────────────────────────────────────────────────
API_KEY=your-api-key-here
BASE_URL=https://your-model-endpoint.com/v1
MODEL_ID=qwen2-5-7b-instruct

# ── Container image (required for deployment) ───────────────────────────────
CONTAINER_IMAGE=quay.io/your-username/langgraph-react-agent:latest

# ── Agent server ─────────────────────────────────────────────────────────────
# PORT=8000

# ── MLflow tracing (optional) ───────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=langgraph-react-agent
# MLFLOW_HTTP_REQUEST_TIMEOUT=2
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=0

# ── Guardrails (Step 5 of the walkthrough) ──────────────────────────────────
# After deploying NeMo Guardrails, change BASE_URL to the guardrails service
# so all LLM calls are routed through the safety proxy:
#
# BASE_URL=http://langgraph-react-agent-guardrails.<namespace>.svc.cluster.local/v1
#
# The guardrails proxy forwards to the LLM at LLM_BASE_URL:
# LLM_BASE_URL=http://vllm.<namespace>.svc.cluster.local:8000/v1
